<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/vb_primary</item>
        <item name="android:navigationBarColor">@color/vb_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/vb_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/vb_primary_dark</item>
        <item name="android:navigationBarColor">@color/vb_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/vb_surface_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
